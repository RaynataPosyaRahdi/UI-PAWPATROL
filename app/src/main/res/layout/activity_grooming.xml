<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFD6E8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_petshop"
            android:layout_marginBottom="12dp"/>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking Grooming"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#4E4E4E"
            android:layout_gravity="center"/>

        <!-- DESCRIPTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Give your furry friend the love and care they deserve. Keep them clean, healthy, happy, and adorable with our professional grooming services."
            android:textSize="15sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"/>

        <!-- NAMA USER -->
        <EditText
            android:id="@+id/etNama"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:hint="Nama Pemilik"
            android:paddingStart="16dp"
            android:background="#FFFFFF"/>

        <!-- ALAMAT -->
        <EditText
            android:id="@+id/etAlamat"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="14dp"
            android:hint="Alamat Lengkap"
            android:gravity="top"
            android:padding="16dp"
            android:background="#FFFFFF"/>


        <!-- NAMA HEWAN -->
        <EditText
            android:id="@+id/etNamaHewan"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:hint="Nama Hewan"
            android:paddingStart="16dp"
            android:background="#FFFFFF"/>

        <!-- JENIS HEWAN -->
        <EditText
            android:id="@+id/etJenisHewan"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:hint="Jenis Hewan (Kucing/Anjing)"
            android:paddingStart="16dp"
            android:background="#FFFFFF"/>

        <!-- UMUR -->
        <EditText
            android:id="@+id/etUmur"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:hint="Umur Hewan"
            android:inputType="number"
            android:paddingStart="16dp"
            android:background="#FFFFFF"/>

        <!-- TANGGAL BOOKING -->
        <EditText
            android:id="@+id/etTanggal"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:hint="Tanggal Booking"
            android:paddingStart="16dp"
            android:background="#FFFFFF"/>

        <!-- JAM BOOKING -->
        <EditText
            android:id="@+id/etJam"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:hint="Jam Booking"
            android:paddingStart="16dp"
            android:background="#FFFFFF"/>

        <!-- TITLE LAYANAN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Layanan Grooming ✂️"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:textColor="#4E4E4E"/>

        <!-- BASIC GROOMING -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardBasic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            card_view:cardCornerRadius="16dp"
            card_view:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐶 Basic Grooming"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mandi standar, sisir bulu, ear cleaning, nail trim"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- KUTU JAMUR -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardKutu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            card_view:cardCornerRadius="16dp"
            card_view:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🦠 Treatment Kutu/Jamur"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perawatan khusus dengan shampo medicated"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- GROOMING GIMBAL -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardGimbal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            card_view:cardCornerRadius="16dp"
            card_view:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐾 Grooming Bulu Gimbal"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mengurai atau mencukur bulu kusut parah"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- STYLING -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStyling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            card_view:cardCornerRadius="16dp"
            card_view:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✂️ Styling / Cukur"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Potong bulu untuk kesehatan dan estetika"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- DRY GROOMING -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            card_view:cardCornerRadius="16dp"
            card_view:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌬 Dry Grooming"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mandi kering tanpa air"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CATATAN -->
        <EditText
            android:id="@+id/etCatatan"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="16dp"
            android:hint="Catatan Tambahan"
            android:gravity="top"
            android:padding="16dp"
            android:background="#FFFFFF"/>

        <!-- TOTAL -->
        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total : Rp 0"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#4E4E4E"
            android:layout_marginTop="24dp"/>

        <!-- BUTTON -->
        <Button
            android:id="@+id/btnBooking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Konfirmasi Booking 🐾"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="#C8A2FF"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>